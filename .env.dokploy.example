# Paste values into Dokploy Environment; never commit the filled version.
# Dokploy service: Docker Compose, source Guille0197/freelingo,
# branch feat/english-only-dokploy, file docker-compose.dokploy.yml.
APP_HOST=english.example.com
ROUTER_PREFIX=freelingo-personal
TRAEFIK_CERT_RESOLVER=letsencrypt
# Absolute path on VM 105. Existing installation: use its EXACT previous DATA_PATH.
DATA_PATH=/opt/freelingo/data
POSTGRES_DB=freelingo
POSTGRES_USER=freelingo
# Generate each independently, e.g. openssl rand -hex 32. Use URL-safe hex passwords.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY=
# Text LLM only. Pick a currently available model ID in OpenRouter's catalog.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Separate OpenAI account/key for speech. An OpenRouter key does not replace this key.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
OPENAI_TTS_SPEED=1.0
OPENAI_STT_MODEL=whisper-1
UVICORN_WORKERS=1
EXERCISE_GENERATION_TIMEOUT_SECONDS=600
LOG_LEVEL=INFO
